# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Backend (Django) ---
# Generate one with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Vite) ---
# URL the browser uses to reach the backend (not the Docker service name).
VITE_API_URL=http://localhost:8000
